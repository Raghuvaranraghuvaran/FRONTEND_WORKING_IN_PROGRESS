# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (the React/Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database engine: `sqlite` (zero-config dev) or `postgresql` (production).
DB_ENGINE=sqlite

# PostgreSQL (used when DB_ENGINE=postgresql)
POSTGRES_DB=returnguard
POSTGRES_USER=returnguard
POSTGRES_PASSWORD=returnguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_ACCESS_MINUTES=60
JWT_REFRESH_MINUTES=10080

# Mock payment gateway + webhook (never trust frontend payment messages)
PAYMENT_GATEWAY_SECRET=dev-gateway-secret
PAYMENT_WEBHOOK_URL=/api/payments/webhook/

# Google Sign-In (create credentials in Google Cloud Console -> OAuth 2.0 Client ID, Web)
GOOGLE_CLIENT_ID=

# Email OTP login
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@returnguard.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
OTP_PEPPER=change-me-to-a-random-secret

# Resend transactional email (recommended for production — Gmail SMTP is blocked from cloud IPs)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ReturnGuard <no-reply@returnguard.in>

# Legacy verification demo OTP (used by checkout/return mock flows)
DEMO_OTP=123456
