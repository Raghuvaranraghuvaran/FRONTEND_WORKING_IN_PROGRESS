# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# On Vercel: add these as Environment Variables in project settings.
# ============================================================

# Public Django backend URL. The frontend appends /api automatically
# if the URL doesn't already end with /api.
# Examples:
#   https://your-api.railway.app
#   https://your-api.example.com/api
# Leave empty to run against the built-in mock API (no backend needed).
VITE_API_URL=

# Google OAuth Client ID from Google Cloud Console.
# APIs & Services → Credentials → OAuth 2.0 Client ID (Web application).
# Leave empty to hide the Google sign-in button entirely.
VITE_GOOGLE_CLIENT_ID=
