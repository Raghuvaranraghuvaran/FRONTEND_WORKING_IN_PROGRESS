# Set this when the backend is ready. Merchant setup will POST to {VITE_API_URL}/merchants
# and persist the returned merchant id in the database.
# Leave empty to use the local mock API.
VITE_API_URL=

# Google Sign-In Client ID (create one at Google Cloud Console -> APIs & Services -> Credentials).
# Leave empty to hide the Google sign-in button.
VITE_GOOGLE_CLIENT_ID=
